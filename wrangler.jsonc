// The site on Cloudflare Workers (Workers Builds deploys it from main): the repository's pages and art as static assets
// (.assetsignore leaves out everything that is not part of the site) and cloudflare/worker.mjs for the rest.
// SERVER_ORIGIN is the game server on Render; PROXY_SECRET, the secret it shares with the Worker, is set in the
// dashboard (Settings > Variables and Secrets), never here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dfdf",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // the addresses stay as they are (/about.html, not /about); / and /admin are answered by the Worker
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/peerjs", "/peerjs/*"]
  },
  "vars": {
    "SERVER_ORIGIN": ""
  },
  "observability": { "enabled": true }
}
